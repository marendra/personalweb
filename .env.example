# Public site origin used for canonical URLs, Open Graph, RSS, and sitemap.
PUBLIC_SITE_URL=https://marendra.com

# Public base URL for article images stored in Cloudflare R2 (custom domain).
# Example: https://images.marendra.com
PUBLIC_IMAGE_BASE_URL=https://images.example.com

# Optional site title override.
PUBLIC_SITE_NAME=Marendra
